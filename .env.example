# Copia este archivo como .env y rellena los valores desde el panel de Supabase
# (Project Settings > Database > Connection string). .env no se versiona.

# Pooler en modo transacción (puerto 6543), para la aplicación.
# Termina en ?pgbouncer=true&connection_limit=1
DATABASE_URL=""

# Conexión directa (puerto 5432), para las migraciones.
# Sin IPv6, usa el pooler en modo sesión (puerto 5432 en pooler.supabase.com).
DIRECT_URL=""

# Igual que DIRECT_URL, pero con schema=test. Las pruebas lo exigen,
# para no borrar los datos del demo.
TEST_DATABASE_URL=""
